  {
    "id": "HOME-NOJS-068",
    "kind": "li",
    "text": "About TradeHQ",
    "sha256": "6f9dcf465718ac6f003426dce896299042e2a257a6fbc2da26aadb6159a9c0d0"
  },
  {
    "id": "HOME-NOJS-069",
    "kind": "a",
    "text": "About TradeHQ",
    "sha256": "6f9dcf465718ac6f003426dce896299042e2a257a6fbc2da26aadb6159a9c0d0"
  },
  {
    "id": "HOME-NOJS-070",
    "kind": "p",
    "text": "Educational simulation only — not financial advice. Virtual money; no brokerage transactions. Quotes may be delayed, cached, unavailable or fixed simulator values; generated charts are labelled separately. Practice results do not predict investment outcomes.",
