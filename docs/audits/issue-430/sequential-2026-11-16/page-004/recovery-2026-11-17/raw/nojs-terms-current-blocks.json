    "location": "body/semantic/25",
    "kind": "p",
    "text": "TradeHQ is a free educational simulator. It is not a brokerage, does not execute real trades, and none of its content is financial advice. Full terms below.",
    "id": "TERMS-NOJS-025",
    "contextText": "TradeHQ is a free educational simulator. It is not a brokerage, does not execute real trades, and none of its content is financial advice. Full terms below.",
